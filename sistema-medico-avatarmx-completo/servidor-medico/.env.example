# Configuración del Sistema Médico AvatarMX
ENVIRONMENT=development
PORT=8000

# Base de datos
DATABASE_URL=sqlite:///./medical_system.db
# Para PostgreSQL: postgresql://user:password@localhost/avatarmx

# WordPress
WORDPRESS_URL=https://tudominio.com
WORDPRESS_API_KEY=tu_clave_api_secreta_aqui

# PDFs Médicos
PDF_PROTOCOLS_PATH=./pdfs_medicos
PDF_PROCESSING_ENABLED=true

# Sesiones
SESSION_TIMEOUT=7200
SESSION_CLEANUP_INTERVAL=3600

# Email
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_app
EMAIL_FROM="AvatarMX Medical" <medical@avatarmx.com>

# Seguridad
JWT_SECRET=tu_clave_secreta_jwt_muy_larga
CORS_ORIGINS=["http://localhost:3000", "https://tudominio.com"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=medical_system.log

# Características
ENABLE_PROTOCOL_SPIRITUAL=true
ENABLE_NATURAL_PRODUCTS=true
ENABLE_EMAIL_REPORTS=true

# Tiempos de espera
REQUEST_TIMEOUT=30
PDF_PROCESSING_TIMEOUT=60

# Deploy
DEPLOY_TIMESTAMP=2024-01-01T00:00:00Z
